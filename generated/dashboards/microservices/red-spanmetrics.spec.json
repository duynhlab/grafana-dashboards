                    "spec": {
                      "expr": "histogram_quantile(0.99, sum by (le) (rate(spanmetrics_duration_milliseconds_bucket{span_kind=\"SPAN_KIND_SERVER\",service_name=~\"$service\"}[$__rate_interval])))",
                      "legendFormat": "p99",
                      "range": true
                    }
                  },
                  "refId": "C",
