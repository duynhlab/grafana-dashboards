{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "inventory-overview",
    "namespace": "default",
    "annotations": {
      "grafana.app/folder": "microservices"
    }
  },
  "spec": {
    "annotations": [],
    "cursorSync": "Off",
    "description": "inventory-service, the platform's sole stock authority. Reservation FSM outcomes, availability checks, gRPC RED, and DB latency. Reads inventory:* recording rules where available. Landed at RFC-0021 phase 1; live since phase 4 with three callers -- the order saga, checkout, and product /details.",
    "editable": true,
    "elements": {
      "inventory-check-outcomes": {
        "kind": "Panel",
        "spec": {
          "id": 0,
          "title": "Availability check outcomes",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "expr": "inventory:check:rate5m",
                        "legendFormat": "{{outcome}}"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": false,
                  "calcs": []
                },
                "tooltip": {
                  "mode": "",
                  "sort": ""
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "ops",
                  "custom": {}
                },
                "overrides": []
              }
            }
          }
        }
      },
      "inventory-db-p95": {
        "kind": "Panel",
        "spec": {
          "id": 0,
          "title": "DB query p95",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "expr": "inventory:db_operation_duration:p95_5m",
                        "legendFormat": "p95"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": false,
                  "calcs": []
                },
                "tooltip": {
                  "mode": "",
                  "sort": ""
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "s",
                  "custom": {}
                },
                "overrides": []
              }
            }
          }
        }
      },
      "inventory-grpc-error-ratio": {
        "kind": "Panel",
        "spec": {
          "id": 0,
          "title": "gRPC error ratio by method",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "expr": "inventory:rpc_error:ratio5m",
                        "legendFormat": "{{rpc_method}}"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": false,
                  "calcs": []
                },
                "tooltip": {
                  "mode": "",
                  "sort": ""
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "percentunit",
                  "custom": {}
                },
                "overrides": []
              }
            }
          }
        }
      },
      "inventory-grpc-p95": {
        "kind": "Panel",
        "spec": {
          "id": 0,
          "title": "gRPC p95 by method",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "expr": "inventory:rpc_duration:p95_5m",
                        "legendFormat": "{{rpc_method}}"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": false,
                  "calcs": []
                },
                "tooltip": {
                  "mode": "",
                  "sort": ""
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "s",
                  "custom": {}
                },
                "overrides": []
              }
            }
          }
        }
      },
      "inventory-grpc-rate": {
        "kind": "Panel",
        "spec": {
          "id": 0,
          "title": "gRPC request rate by method",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "expr": "sum by (rpc_method) (rate(rpc_server_call_duration_seconds_count{app=\"inventory\", rpc_method=~\"inventory.v1.InventoryService/.+\"}[$__rate_interval]))",
                        "legendFormat": "{{rpc_method}}"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": false,
                  "calcs": []
                },
                "tooltip": {
                  "mode": "",
                  "sort": ""
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "ops",
                  "custom": {}
                },
                "overrides": []
              }
            }
          }
        }
      },
      "inventory-readme": {
        "kind": "Panel",
        "spec": {
          "id": 0,
          "title": "Read this panel before the flat lines",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "text",
            "version": "",
            "spec": {
              "options": {
                "mode": "markdown",
                "content": "**inventory-service is the sole stock authority and has three live callers** since RFC-0021 phase 4: the order saga (reserve/commit/release), checkout (availability), and product `/details`. gRPC-only -- no HTTP edge route -- so `:8080` carries only `/health` and `/ready` and every panel here reads the rpc_* RED metrics.\n\nA flat rate is therefore a **finding**, not the expected phase-1 reading it used to be. On a freshly rebuilt cluster it just means no traffic has run yet."
              },
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              }
            }
          }
        }
      },
      "inventory-reservation-outcomes": {
        "kind": "Panel",
        "spec": {
          "id": 0,
          "title": "Reservation outcomes by operation",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "expr": "inventory:reservation:rate5m",
                        "legendFormat": "{{operation}} {{outcome}}"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": false,
                  "calcs": []
                },
                "tooltip": {
                  "mode": "",
                  "sort": ""
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "ops",
                  "custom": {}
                },
                "overrides": []
              }
            }
          }
        }
      }
    },
    "layout": {
      "kind": "RowsLayout",
      "spec": {
