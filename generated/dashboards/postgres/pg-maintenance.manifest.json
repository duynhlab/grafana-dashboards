      "top-tables": {
        "kind": "Panel",
        "spec": {
          "id": 0,
          "title": "Top tables by size",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "expr": "topk(20, sum by (cnpg_io_cluster, datname, schemaname, tablename) (cnpg_pg_table_size_total_bytes{cnpg_io_cluster=~\"$cluster\", datname=~\"$datname\"}))",
                        "format": "table",
                        "instant": true
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [
                {
                  "kind": "Transformation",
                  "group": "organize",
                  "spec": {
                    "options": {
                      "excludeByName": {
                        "Time": true,
                        "instance": true,
                        "job": true
                      },
                      "renameByName": {
                        "Value": "Size",
                        "cnpg_io_cluster": "Cluster",
                        "datname": "Database",
                        "schemaname": "Schema",
                        "tablename": "Table"
                      }
                    }
                  }
                },
                {
                  "kind": "Transformation",
                  "group": "sortBy",
                  "spec": {
                    "options": {
                      "fields": {},
                      "sort": [
                        {
                          "desc": true,
                          "field": "Size"
                        }
                      ]
                    }
                  }
                }
              ],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "table",
            "version": "",
            "spec": {
              "options": {
                "frameIndex": 0,
                "showHeader": true,
                "showTypeIcons": false,
                "footer": {
                  "show": false,
                  "reducer": null,
                  "countRows": false
                },
                "cellHeight": "sm"
              },
              "fieldConfig": {
                "defaults": {
                  "custom": {
                    "align": "auto",
                    "inspect": false
                  }
                },
                "overrides": [
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Size"
                    },
                    "properties": [
                      {
                        "id": "unit",
                        "value": "bytes"
                      },
                      {
                        "id": "custom.cellOptions",
                        "value": {
                          "mode": "gradient",
                          "type": "gauge"
                        }
                      }
                    ]
                  }
                ]
              }
            }
          }
        }
      },
      "total-dead": {
        "kind": "Panel",
        "spec": {
          "id": 0,
