{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "pg-maintenance",
    "namespace": "default",
    "annotations": {
      "grafana.app/folder": "databases"
    }
  },
  "spec": {
    "annotations": [],
    "cursorSync": "Off",
    "description": "CloudNativePG maintenance signals: locks \u0026 blocking, checkpointer, autovacuum \u0026 bloat, long transactions and VACUUM progress. Complements pg-io-waits and pg-query-performance. Tested on PostgreSQL 18.",
    "editable": true,
    "elements": {
      "active-vacuums": {
        "kind": "Panel",
        "spec": {
          "id": 0,
          "title": "Active vacuums",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "expr": "cnpg_pg_stat_progress_vacuum_heap_blks_scanned{cnpg_io_cluster=~\"$cluster\", datname=~\"$datname\"}",
                        "format": "table",
                        "instant": true
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [
                {
                  "kind": "Transformation",
                  "group": "organize",
                  "spec": {
                    "options": {
                      "excludeByName": {
                        "Time": true,
                        "Value": true,
                        "container": true,
                        "endpoint": true,
                        "instance": true,
                        "job": true,
                        "namespace": true,
                        "pod": true,
                        "prometheus": true
                      },
                      "renameByName": {
                        "cnpg_io_cluster": "Cluster",
                        "datname": "DB",
                        "phase": "Phase",
                        "pid": "PID",
                        "relname": "Table"
                      }
                    }
                  }
                }
              ],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "table",
            "version": "",
            "spec": {
              "options": {
                "frameIndex": 0,
                "showHeader": true,
                "showTypeIcons": false,
                "footer": {
                  "show": false,
                  "reducer": null,
                  "countRows": false
                },
                "cellHeight": "sm"
              },
              "fieldConfig": {
                "defaults": {
                  "custom": {
                    "align": "auto",
                    "inspect": false
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "autovacuum-runs": {
        "kind": "Panel",
        "spec": {
          "id": 0,
          "title": "Autovacuum runs / sec",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "expr": "sum by (datname) (rate(cnpg_pg_stat_user_tables_autovacuum_autovacuum_count{cnpg_io_cluster=~\"$cluster\", datname=~\"$datname\"}[15m]))",
                        "legendFormat": "{{datname}}"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": false,
                  "calcs": []
                },
                "tooltip": {
                  "mode": "",
                  "sort": ""
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "ops",
                  "custom": {}
                },
                "overrides": []
              }
            }
          }
        }
      },
      "blocked": {
        "kind": "Panel",
        "spec": {
          "id": 0,
          "title": "Blocked queries",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "expr": "sum(cnpg_pg_blocking_queries_blocked_queries{cnpg_io_cluster=~\"$cluster\"})"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "",
            "spec": {
              "options": {
                "graphMode": "area",
                "colorMode": "value",
                "justifyMode": "auto",
                "textMode": "auto",
                "wideLayout": true,
                "showPercentChange": false,
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ]
                },
                "percentChangeColorMode": "standard",
                "orientation": ""
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": null,
                        "color": "green"
                      },
                      {
                        "value": 1,
                        "color": "yellow"
                      },
                      {
                        "value": 5,
                        "color": "red"
                      }
                    ]
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "checkpoint-time": {
        "kind": "Panel",
        "spec": {
          "id": 0,
          "title": "Checkpoint write / sync time",
          "description": "",
          "links": [],
