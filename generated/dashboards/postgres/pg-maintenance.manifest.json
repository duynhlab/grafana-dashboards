                "percentChangeColorMode": "standard",
                "orientation": ""
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": null,
                        "color": "green"
                      },
                      {
                        "value": 1,
                        "color": "yellow"
                      }
                    ]
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "locks-by-db": {
        "kind": "Panel",
