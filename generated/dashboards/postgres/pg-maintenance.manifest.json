                      "spec": {
                        "expr": "sum(rate(cnpg_pg_stat_checkpointer_checkpoints_timed{cnpg_io_cluster=~\"$cluster\"}[5m]))",
                        "legendFormat": "timed"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "expr": "sum(rate(cnpg_pg_stat_checkpointer_checkpoints_req{cnpg_io_cluster=~\"$cluster\"}[5m]))",
                        "legendFormat": "requested",
                        "range": true
                      }
                    },
                    "refId": "B",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": false,
                  "calcs": []
                },
                "tooltip": {
                  "mode": "",
                  "sort": ""
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "ops",
                  "custom": {}
                },
                "overrides": []
              }
            }
          }
        }
      },
      "dead-tuple-ratio": {
        "kind": "Panel",
        "spec": {
          "id": 0,
          "title": "Dead-tuple ratio — top tables",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "expr": "topk(10, sum by (datname, relname) (cnpg_pg_stat_user_tables_autovacuum_n_dead_tup{cnpg_io_cluster=~\"$cluster\", datname=~\"$datname\"}) / clamp_min(sum by (datname, relname) (cnpg_pg_stat_user_tables_autovacuum_n_dead_tup{cnpg_io_cluster=~\"$cluster\", datname=~\"$datname\"}) + sum by (datname, relname) (cnpg_pg_stat_user_tables_autovacuum_n_live_tup{cnpg_io_cluster=~\"$cluster\", datname=~\"$datname\"}), 1))",
                        "legendFormat": "{{datname}}/{{relname}}"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": false,
                  "calcs": []
                },
                "tooltip": {
                  "mode": "",
                  "sort": ""
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "percentunit",
                  "custom": {}
                },
                "overrides": []
              }
            }
          }
        }
      },
      "idle-in-tx": {
        "kind": "Panel",
        "spec": {
