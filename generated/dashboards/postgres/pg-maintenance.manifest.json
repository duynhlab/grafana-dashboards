            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "expr": "sum(rate(cnpg_pg_stat_checkpointer_checkpoint_write_time{cnpg_io_cluster=~\"$cluster\"}[5m]))",
                        "legendFormat": "write"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "expr": "sum(rate(cnpg_pg_stat_checkpointer_checkpoint_sync_time{cnpg_io_cluster=~\"$cluster\"}[5m]))",
                        "legendFormat": "sync",
                        "range": true
                      }
                    },
                    "refId": "B",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": false,
                  "calcs": []
                },
                "tooltip": {
                  "mode": "",
                  "sort": ""
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "ms",
                  "custom": {}
                },
                "overrides": []
              }
            }
          }
        }
      },
      "checkpoints": {
        "kind": "Panel",
        "spec": {
          "id": 0,
          "title": "Checkpoints / sec (timed vs requested)",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
