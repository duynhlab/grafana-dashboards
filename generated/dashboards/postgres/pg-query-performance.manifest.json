                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "expr": "topk(25, sum by (datname, queryid, query) (rate(cnpg_pg_stat_statements_time_milliseconds{cnpg_io_cluster=~\"$cluster\", datname=~\"$datname\"}[5m])))",
