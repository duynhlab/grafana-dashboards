{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "pg-query-performance"
  },
  "spec": {
    "annotations": [],
    "cursorSync": "Off",
    "description": "CloudNativePG pg_stat_statements: throughput, latency, cache efficiency, block I/O and top statements. Complements pg-io-waits and pg-maintenance. Tested on PostgreSQL 18.",
    "editable": true,
    "elements": {
      "cache-hit": {
        "kind": "Panel",
        "spec": {
          "id": 0,
          "title": "Cache hit ratio",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "expr": "sum(rate(cnpg_pg_stat_statements_shared_blks_hit{cnpg_io_cluster=~\"$cluster\", datname=~\"$datname\"}[5m])) / clamp_min(sum(rate(cnpg_pg_stat_statements_shared_blks_hit{cnpg_io_cluster=~\"$cluster\", datname=~\"$datname\"}[5m])) + sum(rate(cnpg_pg_stat_statements_shared_blks_read{cnpg_io_cluster=~\"$cluster\", datname=~\"$datname\"}[5m])), 1)"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "",
            "spec": {
              "options": {
                "graphMode": "area",
                "colorMode": "value",
                "justifyMode": "auto",
                "textMode": "auto",
                "wideLayout": true,
                "showPercentChange": false,
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ]
                },
                "percentChangeColorMode": "standard",
                "orientation": ""
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "percentunit",
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": null,
                        "color": "red"
                      },
                      {
                        "value": 0.9,
                        "color": "yellow"
                      },
                      {
                        "value": 0.99,
                        "color": "green"
                      }
                    ]
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "calls": {
        "kind": "Panel",
        "spec": {
          "id": 0,
          "title": "Calls / sec",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
