                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "expr": "sum by (datname, queryid, query) (rate(cnpg_pg_stat_statements_calls{cnpg_io_cluster=~\"$cluster\", datname=~\"$datname\"}[5m]))",
