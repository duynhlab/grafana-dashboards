                  "kind": "Transformation",
                  "group": "merge",
                  "spec": {
                    "options": {}
                  }
                },
                {
                  "kind": "Transformation",
                  "group": "organize",
                  "spec": {
                    "options": {
                      "excludeByName": {
                        "Time": true
                      },
                      "renameByName": {
                        "Value #A": "Exec ms/s",
                        "Value #B": "Calls/s",
                        "Value #C": "Mean ms",
                        "Value #D": "Rows/s",
                        "datname": "Database",
                        "query": "Query",
                        "queryid": "Query ID"
                      }
                    }
                  }
                },
                {
                  "kind": "Transformation",
                  "group": "sortBy",
                  "spec": {
                    "options": {
                      "fields": {},
