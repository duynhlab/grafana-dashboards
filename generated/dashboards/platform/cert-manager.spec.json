    "certs-expiring-24h": {
      "kind": "Panel",
      "spec": {
        "id": 0,
        "title": "Certificates expiring \u003c 24h",
        "description": "",
        "links": [],
        "data": {
          "kind": "QueryGroup",
          "spec": {
            "queries": [
              {
                "kind": "PanelQuery",
                "spec": {
                  "query": {
                    "kind": "DataQuery",
                    "group": "prometheus",
                    "version": "v0",
                    "datasource": {
                      "name": "prometheus"
                    },
                    "spec": {
                      "expr": "count((certmanager_certificate_expiration_timestamp_seconds - time()) \u003c 24*3600) OR on() vector(0)"
                    }
                  },
                  "refId": "A",
                  "hidden": false
                }
              }
            ],
            "transformations": [],
            "queryOptions": {}
          }
        },
