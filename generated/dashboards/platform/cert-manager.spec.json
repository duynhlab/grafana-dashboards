                    "version": "v0",
                    "datasource": {
                      "name": "prometheus"
                    },
                    "spec": {
                      "expr": "sum(rate(certmanager_http_acme_client_request_count[$__rate_interval])) by (status, path)",
                      "legendFormat": "{{status}} {{path}}"
                    }
                  },
                  "refId": "A",
                  "hidden": false
                }
              }
            ],
            "transformations": [],
            "queryOptions": {}
          }
        },
        "vizConfig": {
