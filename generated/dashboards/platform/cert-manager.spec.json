            "options": {
              "graphMode": "area",
              "colorMode": "value",
              "justifyMode": "auto",
              "textMode": "auto",
              "wideLayout": true,
              "showPercentChange": false,
              "reduceOptions": {
                "calcs": [
                  "lastNotNull"
                ]
              },
              "percentChangeColorMode": "standard",
              "orientation": ""
            },
            "fieldConfig": {
              "defaults": {
                "unit": "short",
                "thresholds": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "value": null,
                      "color": "green"
                    },
                    {
                      "value": 1,
                      "color": "red"
                    }
                  ]
                }
              },
              "overrides": []
