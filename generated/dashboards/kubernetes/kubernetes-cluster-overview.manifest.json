{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "kubernetes-cluster-overview",
    "namespace": "default",
    "annotations": {
      "grafana.app/folder": "kubernetes"
    }
  },
  "spec": {
    "annotations": [],
    "cursorSync": "Off",
    "description": "Kubernetes cluster overview using the USE method. Covers node/pod counts, workload health, resource utilization, and persistent volume storage.",
    "editable": true,
    "elements": {
      "cpu-req-cap": {
        "kind": "Panel",
        "spec": {
          "id": 0,
          "title": "CPU Requests vs Capacity",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "expr": "sum(kube_pod_container_resource_requests{resource=\"cpu\"}) / sum(kube_node_status_allocatable{resource=\"cpu\"})"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "gauge",
            "version": "",
            "spec": {
              "options": {
                "showThresholdLabels": false,
                "showThresholdMarkers": true,
                "sizing": "auto",
                "minVizWidth": 75,
                "reduceOptions": {
                  "calcs": []
                },
                "minVizHeight": 75,
                "orientation": ""
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "percentunit"
                },
                "overrides": []
              }
            }
          }
        }
      },
      "cpu-throttle": {
        "kind": "Panel",
        "spec": {
          "id": 0,
          "title": "CPU Throttled Containers",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "expr": "sum by (namespace, pod) (increase(container_cpu_cfs_throttled_periods_total{container!=\"\"}[5m])) / sum by (namespace, pod) (increase(container_cpu_cfs_periods_total{container!=\"\"}[5m])) \u003e 0",
                        "legendFormat": "{{namespace}}/{{pod}}"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": false,
                  "calcs": []
                },
                "tooltip": {
                  "mode": "",
                  "sort": ""
                }
              },
              "fieldConfig": {
                "defaults": {
                  "custom": {}
                },
                "overrides": []
              }
            }
          }
        }
      },
