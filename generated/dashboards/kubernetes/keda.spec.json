{
  "annotations": [],
  "cursorSync": "Off",
  "description": "KEDA as the Temporal workers' autoscaler (ADR-055): what the temporal scaler computed per worker version, what the HPA it renders actually did, the server backlog and SDK schedule-to-start it is meant to drain, and KEDA's own health.",
  "editable": true,
  "elements": {
    "current-vs-max-replicas": {
      "kind": "Panel",
      "spec": {
        "id": 0,
        "title": "Current vs max replicas",
        "description": "",
        "links": [],
        "data": {
          "kind": "QueryGroup",
          "spec": {
            "queries": [
              {
                "kind": "PanelQuery",
                "spec": {
                  "query": {
                    "kind": "DataQuery",
                    "group": "prometheus",
                    "version": "v0",
                    "datasource": {
                      "name": "prometheus"
                    },
                    "spec": {
                      "expr": "sum by (horizontalpodautoscaler) (kube_horizontalpodautoscaler_status_current_replicas{namespace=~\"$namespace\", horizontalpodautoscaler=~\"keda-hpa-.*\"})",
                      "legendFormat": "{{horizontalpodautoscaler}} current"
                    }
                  },
                  "refId": "A",
                  "hidden": false
                }
              },
              {
                "kind": "PanelQuery",
                "spec": {
                  "query": {
                    "kind": "DataQuery",
                    "group": "prometheus",
                    "version": "v0",
                    "datasource": {
                      "name": "prometheus"
                    },
                    "spec": {
                      "expr": "sum by (horizontalpodautoscaler) (kube_horizontalpodautoscaler_spec_max_replicas{namespace=~\"$namespace\", horizontalpodautoscaler=~\"keda-hpa-.*\"})",
                      "legendFormat": "{{horizontalpodautoscaler}} max",
                      "range": true
                    }
                  },
                  "refId": "B",
                  "hidden": false
                }
              }
            ],
            "transformations": [],
            "queryOptions": {}
          }
        },
        "vizConfig": {
          "kind": "VizConfig",
          "group": "timeseries",
          "version": "",
          "spec": {
            "options": {
              "legend": {
                "displayMode": "list",
                "placement": "bottom",
                "showLegend": false,
                "calcs": []
              },
              "tooltip": {
                "mode": "",
                "sort": ""
              }
            },
            "fieldConfig": {
              "defaults": {
                "unit": "short",
                "custom": {}
              },
              "overrides": []
            }
          }
        }
      }
    },
