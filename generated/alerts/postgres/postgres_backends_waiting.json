{
  "UID": "postgres_backends_waiting",
  "Title": "PostgreSQL backends waiting",
  "Domain": "postgres",
  "Folder": "Databases",
  "Group": "databases",
  "Expr": "sum (cnpg_backends_waiting_total{cnpg_io_cluster=~\"$cluster\", pod=~\"$pod\"})",
  "For": "10m",
  "Threshold": 0,
  "Labels": {
    "component": "io-waits",
    "domain": "postgres",
    "severity": "warning"
  },
  "Annotations": {
    "dashboard_uid": "pg-io-waits",
    "description": "cnpg_backends_waiting_total is above zero for the evaluation window.",
    "summary": "PostgreSQL backends are waiting"
  }
}
