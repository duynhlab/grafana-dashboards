{
  "UID": "kubernetes_crashlooping_pods",
  "Title": "Kubernetes crashlooping pods",
  "Domain": "kubernetes",
  "Folder": "Kubernetes",
  "Group": "kubernetes",
  "Expr": "count(max_over_time(kube_pod_container_status_waiting_reason{reason=\"CrashLoopBackOff\"}[$__rate_interval]) == 1)",
  "For": "5m",
  "Threshold": 0,
  "Labels": {
    "component": "workloads",
    "domain": "kubernetes",
    "severity": "warning"
  },
  "Annotations": {
    "dashboard_uid": "kubernetes-cluster-overview",
    "description": "At least one container has been in CrashLoopBackOff over the last 5m.",
    "summary": "Pods are CrashLoopBackOff"
  }
}
