{
  "UID": "kubernetes_pending_pods",
  "Title": "Kubernetes pending pods",
  "Domain": "kubernetes",
  "Folder": "Kubernetes",
  "Group": "kubernetes",
  "Expr": "count(kube_pod_status_phase{phase=\"Pending\"} == 1)",
  "For": "15m",
  "Threshold": 0,
  "Labels": {
    "component": "scheduler",
    "domain": "kubernetes",
    "severity": "warning"
  },
  "Annotations": {
    "dashboard_uid": "kubernetes-cluster-overview",
    "description": "One or more pods have remained Pending.",
    "summary": "Pods stuck Pending"
  }
}
