          "expr": "sum(rate(cnpg_pg_stat_statements_time_milliseconds{cnpg_io_cluster=~\"$cluster\", datname=~\"$datname\"}[5m])) / clamp_min(sum(rate(cnpg_pg_stat_statements_calls{cnpg_io_cluster=~\"$cluster\", datname=~\"$datname\"}[5m])), 1)",
