    {
      "id": 6,
      "type": "timeseries",
      "title": "Checkpoints / sec (timed vs requested)",
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum(rate(cnpg_pg_stat_checkpointer_checkpoints_timed{cnpg_io_cluster=~\"$cluster\"}[5m]))",
          "range": true,
          "instant": false,
          "refId": "A",
          "legendFormat": "timed"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum(rate(cnpg_pg_stat_checkpointer_checkpoints_req{cnpg_io_cluster=~\"$cluster\"}[5m]))",
          "range": true,
          "instant": false,
          "refId": "B",
          "legendFormat": "requested"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "mappings": [],
          "unit": "ops",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "'requested' spikes = checkpoints forced by WAL pressure, not the timeout \u2014 raise max_wal_size / checkpoint_timeout."
    },
